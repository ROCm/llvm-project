    ```
      MODULE M
        TYPE :: DT
          PROCEDURE(Fun), POINTER, NOPASS :: pp1
        END TYPE
    
        CONTAINS
    
        INTEGER FUNCTION Fun(Arg)
        INTEGER :: Arg
          Fun = Arg
        END FUNCTION
    
