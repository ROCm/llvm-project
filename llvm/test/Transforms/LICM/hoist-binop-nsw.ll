; CHECK-LABEL: define void @sext_provable(
; CHECK-SAME: ptr [[P:%.*]], i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[C1:%.*]] = and i32 [[A]], 65535
; CHECK-NEXT:    [[C2:%.*]] = and i32 [[B]], 65535
; CHECK-NEXT:    [[INVARIANT_OP:%.*]] = add nsw i32 [[C1]], [[C2]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[IDX_REASS:%.*]] = add nsw i32 [[IV]], [[INVARIANT_OP]]
; CHECK-NEXT:    [[SIDX:%.*]] = sext i32 [[IDX_REASS]] to i64
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr i8, ptr [[P]], i64 [[SIDX]]
; CHECK-NEXT:    store i8 0, ptr [[GEP]], align 1
; CHECK-NEXT:    [[IV_NEXT]] = add nsw i32 [[IV]], 1
; CHECK-NEXT:    br label %[[LOOP]]
;
entry:
  %c1 = and i32 %a, 65535
  %c2 = and i32 %b, 65535
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %step = add nsw i32 %iv, %c1
  %idx = add nsw i32 %step, %c2
  %sidx = sext i32 %idx to i64
  %gep = getelementptr i8, ptr %p, i64 %sidx
