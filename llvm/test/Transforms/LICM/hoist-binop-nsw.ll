; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[B_REASS:%.*]] = add i32 [[IV]], [[INVARIANT_OP]]
; CHECK-NEXT:    [[IDX:%.*]] = add nsw i32 [[B_REASS]], [[C3]]
; CHECK-NEXT:    [[SIDX:%.*]] = sext i32 [[IDX]] to i64
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr i8, ptr [[P]], i64 [[SIDX]]
; CHECK-NEXT:    store i8 0, ptr [[GEP]], align 1
; CHECK-NEXT:    [[IV_NEXT]] = add nsw i32 [[IV]], 1
