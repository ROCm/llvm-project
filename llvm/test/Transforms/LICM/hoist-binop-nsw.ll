; RUN: opt -S -passes=licm < %s | FileCheck %s

; Reassociating "(LV + C1) + C2" into "LV + (C1 + C2)" has to drop nsw unless
; C1 + C2 is known to be representable, because the hoisted partial sum is a
; value the original program never computed. Dropping it from a sign-extended
; value defeats later analyses that rely on the extension distributing over
; the arithmetic, so the reassociation is skipped instead.

; Cannot prove %c1 + %c2 is representable, and the result is sign extended, so
; leave the expression alone rather than drop nsw.
define void @sext_unprovable(ptr %p, i32 %c1, i32 %c2) {
; CHECK-LABEL: define void @sext_unprovable(
; CHECK-SAME: ptr [[P:%.*]], i32 [[C1:%.*]], i32 [[C2:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[STEP:%.*]] = add nsw i32 [[IV]], [[C1]]
; CHECK-NEXT:    [[IDX:%.*]] = add nsw i32 [[STEP]], [[C2]]
; CHECK-NEXT:    [[SIDX:%.*]] = sext i32 [[IDX]] to i64
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr i8, ptr [[P]], i64 [[SIDX]]
; CHECK-NEXT:    store i8 0, ptr [[GEP]], align 1
; CHECK-NEXT:    [[IV_NEXT]] = add nsw i32 [[IV]], 1
; CHECK-NEXT:    br label %[[LOOP]]
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %step = add nsw i32 %iv, %c1
  %idx = add nsw i32 %step, %c2
  %sidx = sext i32 %idx to i64
  %gep = getelementptr i8, ptr %p, i64 %sidx
  store i8 0, ptr %gep
  %iv.next = add nsw i32 %iv, 1
  br label %loop
}

; Same shape, but both invariants are masked to 16 bits so the hoisted sum is
; provably representable. Reassociate and keep nsw on both new instructions.
