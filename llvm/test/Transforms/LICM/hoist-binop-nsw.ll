; Floating point has no nsw, so the guard must not inspect overflow flags on
; it and the reassociation still happens. Needs nsz as well as reassoc, since
; that is what makes an fadd associative.
define void @fadd_reassoc(float %c1, float %c2) {
; CHECK-LABEL: define void @fadd_reassoc(
; CHECK-SAME: float [[C1:%.*]], float [[C2:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[INVARIANT_OP:%.*]] = fadd reassoc nsz float [[C1]], [[C2]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi float [ 0.000000e+00, %[[ENTRY]] ], [ [[NEXT_REASS:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[NEXT_REASS]] = fadd reassoc nsz float [[IV]], [[INVARIANT_OP]]
; CHECK-NEXT:    br label %[[LOOP]]
;
entry:
  br label %loop

loop:
  %iv = phi float [ 0.0, %entry ], [ %next, %loop ]
  %step = fadd reassoc nsz float %iv, %c1
  %next = fadd reassoc nsz float %step, %c2
  br label %loop
}
