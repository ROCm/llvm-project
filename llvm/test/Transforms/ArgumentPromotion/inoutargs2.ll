; CHECK-NEXT:    [[STORE_IN_ENTRY_BLOCK_ENDIF_RET:%.*]] = insertvalue { i32, i32 } undef, i32 [[PHI]], 0
; CHECK-NEXT:    [[STORE_IN_ENTRY_BLOCK_ENDIF_RET1:%.*]] = insertvalue { i32, i32 } [[STORE_IN_ENTRY_BLOCK_ENDIF_RET]], i32 [[VAL0]], 1
; CHECK-NEXT:    ret { i32, i32 } [[STORE_IN_ENTRY_BLOCK_ENDIF_RET1]]
;
entry:
  %val0 = load i32, ptr addrspace(1) undef
  store i32 %val0, ptr %out
  br i1 %arg0, label %if, label %endif

if:
  %val1 = load i32, ptr addrspace(1) undef
  br label %endif

endif:
  %phi = phi i32 [ 0, %entry ], [ %val1, %if ]
  ret i32 %phi
}

