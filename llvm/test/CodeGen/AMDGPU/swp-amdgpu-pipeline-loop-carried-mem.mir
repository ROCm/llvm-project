# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=pipeliner -debug-only=pipeliner %s -o /dev/null 2>&1 | FileCheck %s
# REQUIRES: asserts
# A loop that loads a[i] and stores a[i+1] must get a loop-carried memory dependence
# between the load and the store, so they are not reordered across iterations.

# CHECK: SU([[LOAD:[0-9]+]]): {{.*}}GLOBAL_LOAD_DWORD_SADDR
# CHECK: SU([[STORE:[0-9]+]]): GLOBAL_STORE_DWORD_SADDR
# CHECK: ===== Loop Carried Edges Begin =====
# CHECK: Loop carried edges from SU([[LOAD]])
# CHECK-NEXT: Order
# CHECK-NEXT: SU([[STORE]])
# CHECK: Loop carried edges from SU([[STORE]])
# CHECK-NEXT: Order
# CHECK-NEXT: SU([[LOAD]])
# CHECK: ===== Loop Carried Edges End =====

--- |
  define amdgpu_kernel void @swp_amdgpu_pipeline_loop_carried_mem(ptr addrspace(1) %a, i32 inreg %n) #0 {
  entry:
    br label %loop
  loop:
    br label %loop
  exit:
    ret void
  }

  attributes #0 = { "target-cpu"="gfx950" }
...
---
name:            swp_amdgpu_pipeline_loop_carried_mem
alignment:       4
tracksRegLiveness: true
isSSA:           true
liveins:
  - { reg: '$sgpr4_sgpr5', virtual-reg: '%8' }
machineFunctionInfo:
  isEntryFunction: true
  argumentInfo:
    kernargSegmentPtr: { reg: '$sgpr4_sgpr5' }
  stackPtrOffsetReg: '$sgpr32'
  occupancy:       8
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $sgpr4_sgpr5

    %8:sgpr_64(p4) = COPY $sgpr4_sgpr5
    %15:sreg_64_xexec = S_LOAD_DWORDX2_IMM %8(p4), 0, 0 :: (dereferenceable invariant load (s64), align 16, addrspace 4)
    %16:sreg_32_xm0_xexec = S_LOAD_DWORD_IMM %8(p4), 8, 0 :: (dereferenceable invariant load (s32), align 8, addrspace 4)
    %24:sreg_32 = S_ADD_U32 %15.sub0, 4, implicit-def $scc
    %25:sreg_32 = S_ADDC_U32 %15.sub1, 0, implicit-def $scc, implicit $scc
    %0:sreg_64 = REG_SEQUENCE %24, %subreg.sub0, %25, %subreg.sub1
    %14:sreg_32 = S_MOV_B32 0
    %18:vgpr_32 = AV_MOV_B32_IMM_PSEUDO 0, implicit $exec

  bb.1.loop:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)

    %1:sreg_64_xexec_xnull = PHI %0, %bb.0, %4, %bb.1
    %2:sreg_32 = PHI %14, %bb.0, %3, %bb.1
    %19:vgpr_32 = GLOBAL_LOAD_DWORD_SADDR %1, %18, -4, 0, implicit $exec :: (load (s32), addrspace 1)
    %21:vgpr_32 = nofpexcept V_ADD_F32_e32 1065353216, killed %19, implicit $mode, implicit $exec
    %3:sreg_32 = S_ADD_I32 %2, 1, implicit-def dead $scc
    GLOBAL_STORE_DWORD_SADDR %18, killed %21, %1, 0, 0, implicit $exec :: (store (s32), addrspace 1)
    %30:sreg_32 = S_ADD_U32 %1.sub0, 4, implicit-def $scc
    %31:sreg_32 = S_ADDC_U32 %1.sub1, 0, implicit-def $scc, implicit $scc
    %4:sreg_64 = REG_SEQUENCE %30, %subreg.sub0, %31, %subreg.sub1
    S_CMP_LT_I32 %3, %16, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2.exit:
    S_ENDPGM 0
...
