# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1100 -run-pass=machine-scheduler -o - %s | FileCheck %s

# The iterative scheduler computes region pressure bottom-up and, when the next
# region ends directly above the last tracked instruction, asserts that the
# upward tracker is valid. The last tracked instruction is the first
# instruction of a region, which can be a DBG_VALUE. Debug instructions have
# no slot index: SlotIndexes::getInstructionIndex() falls through to the next
# instruction, and asserts when that is a debug instruction too. So a region
# that starts with two DBG_VALUEs used to hit that assertion from
# GCNUpwardRPTracker::isValid().

--- |
  define amdgpu_kernel void @test() #0 !dbg !4 {
    ret void
  }

  attributes #0 = { "amdgpu-sched-strategy"="iterative-ilp" }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/")
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "test", scope: !1, file: !1, line: 1, type: !5, unit: !0)
  !5 = !DISubroutineType(types: !6)
  !6 = !{}
  !7 = !DILocalVariable(name: "x", scope: !4, file: !1, line: 1, type: !8)
  !8 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !9 = !DILocation(line: 1, column: 1, scope: !4)
  !10 = !DILocalVariable(name: "y", scope: !4, file: !1, line: 1, type: !8)
...
---
name:            test
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: test
    ; CHECK: SCHED_BARRIER 0
    ; CHECK-NEXT: DBG_VALUE
    ; CHECK-NEXT: DBG_VALUE
    ; CHECK: S_ENDPGM 0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = V_ADD_U32_e32 %0, %1, implicit $exec
    %3:vgpr_32 = V_ADD_U32_e32 %2, %1, implicit $exec
    SCHED_BARRIER 0
    DBG_VALUE %3, $noreg, !7, !DIExpression(), debug-location !9
    DBG_VALUE %2, $noreg, !10, !DIExpression(), debug-location !9
    %4:vgpr_32 = V_ADD_U32_e32 %3, %0, implicit $exec
    %5:vgpr_32 = V_ADD_U32_e32 %4, %1, implicit $exec
    %6:vgpr_32 = V_ADD_U32_e32 %5, %0, implicit $exec
    S_ENDPGM 0, implicit %6
...
