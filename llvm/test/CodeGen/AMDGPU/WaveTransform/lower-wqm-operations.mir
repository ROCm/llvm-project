# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-- -mcpu=gfx900 -run-pass=amdgpu-lower-wqm-operations -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-- -mcpu=gfx900 -passes=amdgpu-lower-wqm-operations %s -o - | FileCheck %s

# Test that AMDGPULowerWQMOperations correctly lowers WQM and Exact
# mode transitions. This pass is decoupled from SIWholeQuadMode
# and runs late in the LWT pipeline after WaveTransform.

--- |
  define amdgpu_ps void @test_wqm_lowered_to_copy() {
    ret void
  }
  define amdgpu_ps void @test_exact_transition() {
    ret void
  }
  define amdgpu_ps void @test_opaque_strict_brackets() {
    ret void
  }
  define amdgpu_cs void @test_no_wqm_in_cs() {
    ret void
  }
  define amdgpu_ps void @test_live_mask_query() {
    ret void
  }
...

---
# Test WQM pseudo lowering to COPY: the WQM pseudo-instruction should
# be lowered to a simple COPY.
name:            test_wqm_lowered_to_copy
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0

    ; CHECK-LABEL: name: test_wqm_lowered_to_copy
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sreg_64 = COPY $exec
    ; CHECK-NEXT: $exec = S_WQM_B64 $exec, implicit-def $scc
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY [[COPY1]], implicit $exec
    ; CHECK-NEXT: $exec = S_AND_B64 $exec, [[COPY]], implicit-def $scc
    ; CHECK-NEXT: $vgpr0 = COPY [[COPY2]]
    ; CHECK-NEXT: SI_RETURN_TO_EPILOG $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = WQM %0, implicit $exec
    $vgpr0 = COPY %1
    SI_RETURN_TO_EPILOG $vgpr0

...

---
# Test WQM-to-Exact transition: when a function has both WQM-needing
# instructions and Exact-needing instructions, the pass should insert
# appropriate EXEC mask manipulations.
name:            test_exact_transition
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: test_exact_transition
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sreg_64 = COPY $exec
    ; CHECK-NEXT: $exec = S_WQM_B64 $exec, implicit-def $scc
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:sgpr_256 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:sgpr_128 = IMPLICIT_DEF
    ; CHECK-NEXT: undef [[COPY3:%[0-9]+]].sub0:vreg_64 = COPY [[COPY1]]
    ; CHECK-NEXT: [[COPY3:%[0-9]+]].sub1:vreg_64 = COPY [[COPY2]]
    ; CHECK-NEXT: $exec = S_AND_B64 $exec, [[COPY]], implicit-def $scc
    ; CHECK-NEXT: [[IMAGE_SAMPLE_V4_V2_:%[0-9]+]]:vreg_128 = IMAGE_SAMPLE_V4_V2 [[COPY3]], [[DEF]], [[DEF1]], 15, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (dereferenceable load (s128), addrspace 8)
    ; CHECK-NEXT: BUFFER_STORE_DWORD_OFFSET_exact [[IMAGE_SAMPLE_V4_V2_]].sub0, [[DEF1]], 0, 0, 0, 0, implicit $exec
    ; CHECK-NEXT: SI_RETURN_TO_EPILOG $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:sgpr_256 = IMPLICIT_DEF
    %3:sgpr_128 = IMPLICIT_DEF
    undef %4.sub0:vreg_64 = COPY %0
    %4.sub1:vreg_64 = COPY %1
    %5:vreg_128 = IMAGE_SAMPLE_V4_V2 %4, %2, %3, 15, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (dereferenceable load (s128), addrspace 8)
    BUFFER_STORE_DWORD_OFFSET_exact killed %5.sub0:vreg_128, %3, 0, 0, 0, 0, implicit $exec
    SI_RETURN_TO_EPILOG $vgpr0

...

---
# Test opaque ENTER/EXIT strict brackets: the pass should treat
# ENTER_STRICT_WWM/EXIT_STRICT_WWM brackets as opaque regions and
# not make any WQM/Exact transition decisions inside them.
name:            test_opaque_strict_brackets
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: test_opaque_strict_brackets
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sreg_64 = COPY $exec
    ; CHECK-NEXT: $exec = S_WQM_B64 $exec, implicit-def $scc
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:sgpr_256 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:sgpr_128 = IMPLICIT_DEF
    ; CHECK-NEXT: undef [[COPY3:%[0-9]+]].sub0:vreg_64 = COPY [[COPY1]]
    ; CHECK-NEXT: [[COPY3:%[0-9]+]].sub1:vreg_64 = COPY [[COPY2]]
    ; CHECK-NEXT: [[IMAGE_SAMPLE_V4_V2_:%[0-9]+]]:vreg_128 = IMAGE_SAMPLE_V4_V2 [[COPY3]], [[DEF]], [[DEF1]], 15, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (dereferenceable load (s128), addrspace 8)
    ; CHECK-NEXT: [[ENTER_STRICT_WWM:%[0-9]+]]:sreg_64 = ENTER_STRICT_WWM -1, implicit-def $exec, implicit-def $scc, implicit $exec
    ; CHECK-NEXT: [[V_ADD_CO_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_CO_U32_e32 [[IMAGE_SAMPLE_V4_V2_]].sub0, [[IMAGE_SAMPLE_V4_V2_]].sub1, implicit-def $vcc, implicit $exec
    ; CHECK-NEXT: $exec = EXIT_STRICT_WWM [[ENTER_STRICT_WWM]]
    ; CHECK-NEXT: $exec = S_AND_B64 $exec, [[COPY]], implicit-def $scc
    ; CHECK-NEXT: BUFFER_STORE_DWORD_OFFSET_exact [[V_ADD_CO_U32_e32_]], [[DEF1]], 0, 0, 0, 0, implicit $exec
    ; CHECK-NEXT: SI_RETURN_TO_EPILOG $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:sgpr_256 = IMPLICIT_DEF
    %3:sgpr_128 = IMPLICIT_DEF
    undef %4.sub0:vreg_64 = COPY %0
    %4.sub1:vreg_64 = COPY %1
    %5:vreg_128 = IMAGE_SAMPLE_V4_V2 %4, %2, %3, 15, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (dereferenceable load (s128), addrspace 8)
    %6:sreg_64 = ENTER_STRICT_WWM -1, implicit-def $exec, implicit-def $scc, implicit $exec
    %7:vgpr_32 = V_ADD_CO_U32_e32 %5.sub0, %5.sub1, implicit-def $vcc, implicit $exec
    $exec = EXIT_STRICT_WWM %6
    BUFFER_STORE_DWORD_OFFSET_exact %7, %3, 0, 0, 0, 0, implicit $exec
    SI_RETURN_TO_EPILOG $vgpr0

...

---
# Test that compute shaders with no WQM operations are left unchanged.
name:            test_no_wqm_in_cs
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0

    ; CHECK-LABEL: name: test_no_wqm_in_cs
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[V_ADD_CO_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_CO_U32_e32 [[COPY]], [[COPY]], implicit-def $vcc, implicit $exec
    ; CHECK-NEXT: $vgpr0 = COPY [[V_ADD_CO_U32_e32_]]
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_ADD_CO_U32_e32 %0, %0, implicit-def $vcc, implicit $exec
    $vgpr0 = COPY %1
    S_ENDPGM 0

...

---
# Test SI_PS_LIVE lowering: should be replaced with a COPY of the live mask.
name:            test_live_mask_query
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0

    ; CHECK-LABEL: name: test_live_mask_query
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sreg_64 = COPY $exec
    ; CHECK-NEXT: $exec = S_WQM_B64 $exec, implicit-def $scc
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:sgpr_256 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:sgpr_128 = IMPLICIT_DEF
    ; CHECK-NEXT: undef [[COPY2:%[0-9]+]].sub0:vreg_64 = COPY [[COPY1]]
    ; CHECK-NEXT: [[COPY2:%[0-9]+]].sub1:vreg_64 = COPY [[COPY1]]
    ; CHECK-NEXT: $exec = S_AND_B64 $exec, [[COPY]], implicit-def $scc
    ; CHECK-NEXT: dead [[IMAGE_SAMPLE_V4_V2_:%[0-9]+]]:vreg_128 = IMAGE_SAMPLE_V4_V2 [[COPY2]], [[DEF]], [[DEF1]], 15, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (dereferenceable load (s128), addrspace 8)
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:sreg_64 = COPY [[COPY]]
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:vgpr_32 = COPY [[COPY3]]
    ; CHECK-NEXT: $vgpr0 = COPY [[COPY4]]
    ; CHECK-NEXT: SI_RETURN_TO_EPILOG $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:sgpr_256 = IMPLICIT_DEF
    %2:sgpr_128 = IMPLICIT_DEF
    undef %3.sub0:vreg_64 = COPY %0
    %3.sub1:vreg_64 = COPY %0
    %4:vreg_128 = IMAGE_SAMPLE_V4_V2 %3, %1, %2, 15, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (dereferenceable load (s128), addrspace 8)
    %5:sreg_64 = SI_PS_LIVE
    %6:vgpr_32 = COPY %5
    $vgpr0 = COPY %6
    SI_RETURN_TO_EPILOG $vgpr0

...
