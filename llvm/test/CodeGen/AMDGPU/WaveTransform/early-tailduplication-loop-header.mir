# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa -amdgpu-late-wave-transform=1 -simplify-mir -run-pass=early-tailduplication -verify-machineinstrs -o - %s | FileCheck %s
# RUN: not llc -mtriple=amdgpu9.42-amd-amdhsa -O2 -amdgpu-late-wave-transform=1 -start-before=early-tailduplication -stop-after=amdgpu-wave-transform -o /dev/null %s 2>&1 | FileCheck -check-prefix=WT %s

# Divergent loop headers (SI_BRCOND, SI_BRCOND_Z) are not tail-duplicated. A
# uniform header still is, and the wave transform rejects the irreducible cycle.

# WT: LLVM ERROR: amdgpu-wave-transform: irreducible cycle with entries bb.{{[0-9]+}} bb.{{[0-9]+}} in function 'uniform_header' is not supported

---
name:            divergent_header_brcond
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: divergent_header_brcond
  ; CHECK: bb.0:
  ; CHECK-NEXT:   liveins: $sgpr0, $sgpr2_sgpr3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %n:sreg_32 = COPY $sgpr0
  ; CHECK-NEXT:   %cond:sreg_64_xexec = COPY $sgpr2_sgpr3
  ; CHECK-NEXT:   %zero:sreg_32 = S_MOV_B32 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2, %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %i:sreg_32 = PHI %zero, %bb.0, %inext, %bb.4
  ; CHECK-NEXT:   SI_BRCOND %bb.3, %cond, implicit-def $exec, implicit-def $vcc, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_NOP 0
  ; CHECK-NEXT:   S_BRANCH %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   S_CMP_EQ_U32 %i, %n, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.5, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   %one:sreg_32 = S_MOV_B32 1
  ; CHECK-NEXT:   %inext:sreg_32 = S_ADD_I32 %i, %one, implicit-def dead $scc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    liveins: $sgpr0, $sgpr2_sgpr3

    %n:sreg_32 = COPY $sgpr0
    %cond:sreg_64_xexec = COPY $sgpr2_sgpr3
    %zero:sreg_32 = S_MOV_B32 0

  bb.1:
    successors: %bb.2, %bb.3

    %i:sreg_32 = PHI %zero, %bb.0, %inext, %bb.4
    SI_BRCOND %bb.3, %cond, implicit-def $exec, implicit-def $vcc, implicit $exec
    S_BRANCH %bb.2

  bb.2:
    successors: %bb.4

    S_NOP 0
    S_BRANCH %bb.4

  bb.3:
    successors: %bb.5, %bb.4

    S_CMP_EQ_U32 %i, %n, implicit-def $scc
    S_CBRANCH_SCC1 %bb.5, implicit $scc
    S_BRANCH %bb.4

  bb.4:
    successors: %bb.1

    %one:sreg_32 = S_MOV_B32 1
    %inext:sreg_32 = S_ADD_I32 %i, %one, implicit-def dead $scc
    S_BRANCH %bb.1

  bb.5:
    S_ENDPGM 0
...
