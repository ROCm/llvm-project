---
name:            uniform_header
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: uniform_header
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.3, %bb.4
  ; CHECK-NEXT:   liveins: $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %n:sreg_32 = COPY $sgpr0
  ; CHECK-NEXT:   %zero:sreg_32 = S_MOV_B32 0
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.4, implicit undef $scc
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3, %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:sreg_32 = PHI %7, %bb.3, %8, %bb.4
  ; CHECK-NEXT:   %one:sreg_32 = S_MOV_B32 1
  ; CHECK-NEXT:   %inext:sreg_32 = S_ADD_I32 [[PHI]], %one, implicit-def dead $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.4, implicit undef $scc
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:sreg_32 = PHI %inext, %bb.2, %zero, %bb.0
  ; CHECK-NEXT:   S_NOP 0
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   [[PHI2:%[0-9]+]]:sreg_32 = PHI %inext, %bb.2, %zero, %bb.0
  ; CHECK-NEXT:   S_CMP_EQ_U32 [[PHI2]], %n, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.5, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    liveins: $sgpr0

    %n:sreg_32 = COPY $sgpr0
    %zero:sreg_32 = S_MOV_B32 0

  bb.1:
    successors: %bb.3, %bb.4

    %i:sreg_32 = PHI %zero, %bb.0, %inext, %bb.2
    S_CBRANCH_SCC1 %bb.4, implicit undef $scc
    S_BRANCH %bb.3

  bb.2:
