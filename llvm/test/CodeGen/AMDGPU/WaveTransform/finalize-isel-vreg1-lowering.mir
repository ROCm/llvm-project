# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 \
# RUN:   -run-pass=si-fix-sgpr-copies,amdgpu-finalize-isel-wave-transform \
# RUN:   %s -o %t.mir
# RUN: FileCheck %s < %t.mir
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 \
# RUN:   -run-pass=amdgpu-finalize-isel-wave-transform \
# RUN:   -verify-machineinstrs %t.mir -o /dev/null

# Test the dataflow-aware vreg_1 lowering in AMDGPUFinalizeISelWaveTransform.
#
# SIFixSGPRCopies legalizes `$scc = COPY %vreg_1` into `S_AND_B64 %vreg_1,
# $exec`, which creates a scalar consumer of vreg_1.  The finalize pass
# classifies vreg_1 regions: those that transitively feed scalar consumers
# (through COPY/PHI chains) are preserved as wave-mask SGPRs; all others
# are widened to VGPR_32.

# Copy chain: lane-mask -> vreg_1 -> COPY vreg_1 -> S_AND_B64.
# Backward propagation must preserve the entire chain as sreg_64.
---
name:              preserve_vreg1_copy_chain
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: preserve_vreg1_copy_chain
    ; CHECK: [[DEF:%[0-9]+]]:sreg_64 = IMPLICIT_DEF
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sreg_64 = COPY [[DEF]]
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:sreg_64 = COPY [[COPY]]
    ; CHECK-NEXT: [[S_AND_B64_:%[0-9]+]]:sreg_64 = S_AND_B64 [[COPY1]], $exec, implicit-def $scc
    ; CHECK-NEXT: [[S_CSELECT_B64_:%[0-9]+]]:sreg_64 = S_CSELECT_B64 -1, 0, implicit $scc
    ; CHECK-NEXT: S_ENDPGM 0
    %0:sreg_64 = IMPLICIT_DEF
    %1:vreg_1 = COPY %0
    %2:vreg_1 = COPY %1
    $scc = COPY %2
    %3:sreg_64 = S_CSELECT_B64 -1, 0, implicit $scc
    S_ENDPGM 0
...

# PHI chain: lane-mask values from two paths merge through a vreg_1 PHI,
# whose result feeds S_AND_B64.
# All vreg_1 defs in the region must be preserved as sreg_64.
---
name:              preserve_vreg1_phi_chain
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: preserve_vreg1_phi_chain
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:sreg_64 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sreg_64 = COPY [[DEF]]
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF1:%[0-9]+]]:sreg_64 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sreg_64 = COPY [[DEF1]]
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:sreg_64 = PHI [[COPY]], %bb.0, [[COPY1]], %bb.1
  ; CHECK-NEXT:   [[S_AND_B64_:%[0-9]+]]:sreg_64 = S_AND_B64 [[PHI]], $exec, implicit-def $scc
  ; CHECK-NEXT:   [[S_CSELECT_B64_:%[0-9]+]]:sreg_64 = S_CSELECT_B64 -1, 0, implicit $scc
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    %0:sreg_64 = IMPLICIT_DEF
    %1:vreg_1 = COPY %0
    S_BRANCH %bb.2

  bb.1:
    %2:sreg_64 = IMPLICIT_DEF
    %3:vreg_1 = COPY %2
    S_BRANCH %bb.2

  bb.2:
    %4:vreg_1 = PHI %1, %bb.0, %3, %bb.1
    $scc = COPY %4
    %5:sreg_64 = S_CSELECT_B64 -1, 0, implicit $scc
    S_ENDPGM 0
...

# Boundary case: vreg_1 from a lane mask with only VGPR consumers.
# Must widen to VGPR_32 via V_CNDMASK_B32_e64 (no scalar consumer).
---
name:              widen_vreg1_no_scalar_consumer
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: widen_vreg1_no_scalar_consumer
    ; CHECK: [[DEF:%[0-9]+]]:sreg_64_xexec = IMPLICIT_DEF
    ; CHECK-NEXT: [[V_CNDMASK_B32_e64_:%[0-9]+]]:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, -1, [[DEF]], implicit $exec
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY [[V_CNDMASK_B32_e64_]]
    ; CHECK-NEXT: S_ENDPGM 0
    %0:sreg_64 = IMPLICIT_DEF
    %1:vreg_1 = COPY %0
    %2:vgpr_32 = COPY %1
    S_ENDPGM 0
...

# Deferred boundary: preserved vreg_1 (%1) defined in a later MBB (bb.2) than
# a widened consumer (%2) in bb.1.
# Round#2 catches the deferred crossing and emits V_CNDMASK_B32_e64.
---
name:              preserve_vreg1_deferred_cross_block
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: preserve_vreg1_deferred_cross_block
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   [[V_CNDMASK_B32_e64_:%[0-9]+]]:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, -1, %1, implicit $exec
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY [[V_CNDMASK_B32_e64_]]
  ; CHECK-NEXT:   S_ENDPGM 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:sreg_64 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sreg_64_xexec = COPY [[DEF]]
  ; CHECK-NEXT:   [[S_AND_B64_:%[0-9]+]]:sreg_64 = S_AND_B64 [[COPY1]], $exec, implicit-def $scc
  ; CHECK-NEXT:   [[S_CSELECT_B64_:%[0-9]+]]:sreg_64 = S_CSELECT_B64 -1, 0, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  bb.0:
    S_BRANCH %bb.2

  bb.1:
    %2:vreg_1 = COPY %1
    %3:vgpr_32 = COPY %2
    S_ENDPGM 0

  bb.2:
    %0:sreg_64 = IMPLICIT_DEF
    %1:vreg_1 = COPY %0
    $scc = COPY %1
    %4:sreg_64 = S_CSELECT_B64 -1, 0, implicit $scc
    S_BRANCH %bb.1
...
