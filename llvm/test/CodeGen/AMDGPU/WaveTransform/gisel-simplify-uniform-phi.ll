; AMDGPUGlobalISelDivergenceLowering folds a uniform G_PHI that merges a single
; real value through divergent control flow. Only observable at -O0.

; A uniform phi whose incomings are the same kernel-arg value on both edges of a
; divergent branch folds to that value: no G_PHI survives.
define amdgpu_kernel void @uniform_phi_single_value(i32 %n, ptr addrspace(1) %out) {
  ; CHECK-LABEL: name: uniform_phi_single_value
  ; CHECK: bb.1.entry:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr8_sgpr9, $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(p4) = COPY $sgpr8_sgpr9
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32(i32) = COPY $vgpr0
  ; CHECK-NEXT:   [[LOAD:%[0-9]+]]:_(i32) = G_LOAD [[COPY]](p4) :: (invariant load (i32) from %ir.n.kernarg.offset, align 16, addrspace 4)
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 8
  ; CHECK-NEXT:   [[PTR_ADD:%[0-9]+]]:_(p4) = nuw nusw inbounds G_PTR_ADD [[COPY]], [[C]](i64)
  ; CHECK-NEXT:   [[LOAD1:%[0-9]+]]:_(p1) = G_LOAD [[PTR_ADD]](p4) :: (invariant load (p1) from %ir.out.kernarg.offset, addrspace 4)
  ; CHECK-NEXT:   [[ASSERT_ZEXT:%[0-9]+]]:_(i32) = G_ASSERT_ZEXT [[COPY1]], 10
  ; CHECK-NEXT:   [[ICMP:%[0-9]+]]:sreg_32_xm0_xexec(i1) = G_ICMP intpred(sge), [[ASSERT_ZEXT]](i32), [[LOAD]]
  ; CHECK-NEXT:   SI_BRCOND %bb.3, [[ICMP]](i1), implicit-def $exec, implicit-def $vcc, implicit $exec
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.if:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.end:
  ; CHECK-NEXT:   G_STORE [[LOAD]](i32), [[LOAD1]](p1) :: (store (i32) into %ir.out.load, addrspace 1)
  ; CHECK-NEXT:   S_ENDPGM 0
entry:
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  %cmp = icmp slt i32 %tid, %n
  br i1 %cmp, label %if, label %end

if:
  br label %end

end:
  %phi = phi i32 [ %n, %entry ], [ %n, %if ]
  store i32 %phi, ptr addrspace(1) %out
  ret void
}

