# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -amdgpu-late-wave-transform=1 -mtriple=amdgcn -mcpu=gfx1010 -run-pass=amdgpu-wave-transform -o - %s 2>&1 | FileCheck %s
# RUN: llc -amdgpu-late-wave-transform=1 -mtriple=amdgcn -mcpu=gfx1010 -passes=amdgpu-wave-transform -o - %s 2>&1 | FileCheck %s

# Test that the wave-transform pass correctly handles blocks with stale
# indirect-target markings from the thread-level CFG produced by kill
# intrinsics lowered after a callbr with a kill intrnsic usage.
#
# Test 1: Kill terminator and S_BRANCH in the same block that has
# indirect-target successor.
#
# CFG:
#   bb.0 (kill + S_BRANCH %bb.2)
#    |  \
#    |   bb.1 (inlineasm-br-indirect-target, SI_MASKED_UNREACHABLE)
#    v
#   bb.2 (cont)
#    |
#   bb.3 (return)
---
name: kill_unsplit_with_indirect_target
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: kill_unsplit_with_indirect_target
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000), %bb.1(0x00000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
  ; CHECK-NEXT:   [[V_CMP_NE_U32_e64_:%[0-9]+]]:sreg_32_xm0_xexec = V_CMP_NE_U32_e64 [[COPY]], [[COPY1]], implicit $exec
  ; CHECK-NEXT:   SI_KILL_I1_TERMINATOR [[V_CMP_NE_U32_e64_]], 0, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (inlineasm-br-indirect-target):
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SI_MASKED_UNREACHABLE
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_NOP 0
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.2(0x80000000), %bb.1(0x00000000)
    liveins: $vgpr0, $vgpr1

    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:sreg_32_xm0_xexec = V_CMP_NE_U32_e64 %0, %1, implicit $exec
    SI_KILL_I1_TERMINATOR %2, 0, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.2

  bb.1 (inlineasm-br-indirect-target):
    successors: %bb.3(0x80000000)

    SI_MASKED_UNREACHABLE
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3(0x80000000)

    S_NOP 0

  bb.3:
    S_ENDPGM 0
...

# Test 2: Kill terminator and S_BRANCH in the same block inside a
# divergent if-then region. The reconverging algorithm inserts a flow
# block at the merge point (bb.4), so the kill block's S_BRANCH must
# be rewired from bb.4 to the flow block.
#
# Thread CFG:
#   bb.0 (divergent branch)
#    |       \
#   bb.1     |
#  (kill +   |
#  S_BRANCH  |
#  %bb.4)    |
#   |  \     |
#   |  bb.2  |
#   |  (ind) |
#   v        v
#   bb.3 <-- (unreachable via bb.2)
#    |
#   bb.4 (merge)
#    |
#   bb.5 (return)
#
# Wave CFG (expected):
#   bb.0 → bb.1 (primary), flow (secondary)
#   bb.1 → flow (S_BRANCH rewired from bb.4 to flow)
#   flow → bb.4
---
name: kill_unsplit_inside_divergent_region
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: kill_unsplit_inside_divergent_region
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.6(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 0
  ; CHECK-NEXT:   [[V_CMP_EQ_U32_e64_:%[0-9]+]]:sreg_32 = V_CMP_EQ_U32_e64 [[COPY]], [[S_MOV_B32_]], implicit $exec
  ; CHECK-NEXT:   [[S_XOR_B32_:%[0-9]+]]:sreg_32 = S_XOR_B32 [[V_CMP_EQ_U32_e64_]], $exec_lo, implicit-def $scc
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sreg_32 = COPY [[V_CMP_EQ_U32_e64_]]
  ; CHECK-NEXT:   $exec_lo = S_MOV_B32_term [[S_XOR_B32_]]
  ; CHECK-NEXT:   SI_WAVE_CF_EDGE implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_EXECZ %bb.6, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x00000000), %bb.6(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[S_MOV_B32_1:%[0-9]+]]:sreg_32 = S_MOV_B32 1
  ; CHECK-NEXT:   [[V_CMP_NE_U32_e64_:%[0-9]+]]:sreg_32_xm0_xexec = V_CMP_NE_U32_e64 [[COPY]], [[S_MOV_B32_1]], implicit $exec
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sreg_32 = S_OR_B32 [[V_CMP_EQ_U32_e64_]], $exec_lo, implicit-def $scc
  ; CHECK-NEXT:   SI_KILL_I1_TERMINATOR [[V_CMP_NE_U32_e64_]], 0, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (inlineasm-br-indirect-target):
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SI_MASKED_UNREACHABLE
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.6(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_BRANCH %bb.6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $exec_lo = S_OR_B32 $exec_lo, [[V_CMP_EQ_U32_e64_]], implicit-def $scc
  ; CHECK-NEXT:   [[S_XOR_B32_1:%[0-9]+]]:sreg_32 = S_XOR_B32 $exec_lo, [[COPY1]], implicit-def $scc
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sreg_32 = COPY [[COPY1]]
  ; CHECK-NEXT:   $exec_lo = S_MOV_B32_term [[COPY2]]
  ; CHECK-NEXT:   SI_WAVE_CF_EDGE implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_EXECZ %bb.5, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.5(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_NOP 0
  ; CHECK-NEXT:   S_BRANCH %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   $exec_lo = S_OR_B32 $exec_lo, [[S_XOR_B32_1]], implicit-def $scc
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.4
    liveins: $vgpr0

    %0:vgpr_32 = COPY $vgpr0
    %1:sreg_32 = S_MOV_B32 0
    %2:sreg_32 = V_CMP_EQ_U32_e64 %0, %1, implicit $exec
    SI_BRCOND %bb.4, killed %2, implicit-def dead $exec, implicit-def dead $vcc, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.4(0x80000000), %bb.2(0x00000000)

    %3:sreg_32 = S_MOV_B32 1
    %4:sreg_32_xm0_xexec = V_CMP_NE_U32_e64 %0, %3, implicit $exec
    SI_KILL_I1_TERMINATOR %4, 0, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.4

  bb.2 (inlineasm-br-indirect-target):
    successors: %bb.3(0x80000000)

    SI_MASKED_UNREACHABLE
    S_BRANCH %bb.3

  bb.3:
    successors: %bb.5(0x80000000)

    S_BRANCH %bb.5

  bb.4:
    successors: %bb.5(0x80000000)

    S_NOP 0

  bb.5:
    S_ENDPGM 0
...

# Test 3: Kill terminator in its own block, with a split block carrying
# the S_BRANCH and the indirect-target successor (post finalize-isel).
# finalize-isel introduces a temp block (bb.1) and moves the
# indirect-target successor from the block (bb.0) that originally
# contained the KILL intrinsic.
#
# CFG:
#   bb.0 (kill, falls through to bb.1)
#    |
#   bb.1 (S_BRANCH %bb.3)
#    |  \
#    |   bb.2 (inlineasm-br-indirect-target, SI_MASKED_UNREACHABLE)
#    v
#   bb.3 (cont)
#    |
#   bb.4 (return)
---
name: kill_split_with_indirect_target
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: kill_split_with_indirect_target
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
  ; CHECK-NEXT:   [[V_CMP_NE_U32_e64_:%[0-9]+]]:sreg_32_xm0_xexec = V_CMP_NE_U32_e64 [[COPY]], [[COPY1]], implicit $exec
  ; CHECK-NEXT:   SI_KILL_I1_TERMINATOR [[V_CMP_NE_U32_e64_]], 0, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000), %bb.2(0x00000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (inlineasm-br-indirect-target):
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SI_MASKED_UNREACHABLE
  ; CHECK-NEXT:   S_BRANCH %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_NOP 0
  ; CHECK-NEXT:   S_BRANCH %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $vgpr0, $vgpr1

    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:sreg_32_xm0_xexec = V_CMP_NE_U32_e64 %0, %1, implicit $exec
    SI_KILL_I1_TERMINATOR %2, 0, implicit-def dead $exec, implicit-def dead $scc, implicit $exec

  bb.1:
    successors: %bb.3(0x80000000), %bb.2(0x00000000)

    S_BRANCH %bb.3

  bb.2 (inlineasm-br-indirect-target):
    successors: %bb.4(0x80000000)

    SI_MASKED_UNREACHABLE
    S_BRANCH %bb.4

  bb.3:
    successors: %bb.4(0x80000000)

    S_NOP 0

  bb.4:
    S_ENDPGM 0
...
