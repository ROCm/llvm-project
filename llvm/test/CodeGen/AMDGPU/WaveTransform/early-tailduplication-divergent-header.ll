; RUN: llc -mtriple=amdgpu9.42-amd-amdhsa -O2 -global-isel -amdgpu-late-wave-transform=1 < %s | FileCheck %s

; The divergent loop header is not tail-duplicated, so the wave transform lowers
; the loop.

declare i32 @llvm.amdgcn.workitem.id.x()

define amdgpu_kernel void @divergent_header(ptr addrspace(1) %out, i32 %n) {
; CHECK-LABEL: divergent_header:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_load_dwordx2 s[2:3], s[4:5], 0x0
; CHECK-NEXT:    s_load_dword s10, s[4:5], 0x8
; CHECK-NEXT:    v_and_b32_e32 v0, 0x3ff, v0
; CHECK-NEXT:    s_mov_b64 s[6:7], 0
; CHECK-NEXT:    s_mov_b64 s[0:1], 0
; CHECK-NEXT:    v_cmp_ne_u32_e32 vcc, 0, v0
; CHECK-NEXT:    v_mov_b32_e32 v0, 0
; CHECK-NEXT:    v_mov_b32_e32 v1, 2
; CHECK-NEXT:    v_mov_b32_e32 v2, 1
; CHECK-NEXT:  .LBB0_1: ; %header
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    s_and_b64 s[12:13], exec, vcc
; CHECK-NEXT:    s_and_b64 s[4:5], exec, vcc
; CHECK-NEXT:    s_xor_b64 s[4:5], s[4:5], exec
; CHECK-NEXT:    s_xor_b64 s[8:9], exec, s[12:13]
; CHECK-NEXT:    s_mov_b64 exec, s[12:13]
; CHECK-NEXT:    ; divergent control-flow edge
; CHECK-NEXT:    s_cbranch_execz .LBB0_3
; CHECK-NEXT:  .LBB0_2: ; %else
; CHECK-NEXT:    ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    s_cmp_eq_u32 s10, 0
; CHECK-NEXT:    global_store_dword v0, v1, s[2:3] sc0 sc1
; CHECK-NEXT:    s_waitcnt vmcnt(0)
; CHECK-NEXT:    s_cselect_b64 s[6:7], 0, exec
; CHECK-NEXT:  .LBB0_3: ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    s_or_b64 exec, exec, s[8:9]
; CHECK-NEXT:    s_xor_b64 s[8:9], exec, s[4:5]
; CHECK-NEXT:    s_mov_b64 exec, s[4:5]
; CHECK-NEXT:    ; divergent control-flow edge
; CHECK-NEXT:    s_cbranch_execz .LBB0_5
; CHECK-NEXT:  .LBB0_4: ; %then
; CHECK-NEXT:    ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    s_or_b64 s[6:7], s[6:7], exec
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    global_store_dword v0, v2, s[2:3] sc0 sc1
; CHECK-NEXT:    s_waitcnt vmcnt(0)
; CHECK-NEXT:  .LBB0_5: ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    s_or_b64 exec, exec, s[8:9]
; CHECK-NEXT:    s_xor_b64 s[4:5], exec, s[6:7]
; CHECK-NEXT:    s_or_b64 s[0:1], s[0:1], s[4:5]
; CHECK-NEXT:    s_mov_b64 exec, s[6:7]
; CHECK-NEXT:    ; divergent control-flow edge
; CHECK-NEXT:    s_cbranch_execz .LBB0_7
; CHECK-NEXT:  .LBB0_6: ; %latch
; CHECK-NEXT:    ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    s_mov_b64 s[6:7], 0
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    s_add_i32 s10, s10, -1
; CHECK-NEXT:    s_branch .LBB0_1
; CHECK-NEXT:  .LBB0_7: ; %exit
; CHECK-NEXT:    s_endpgm
entry:
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  %cond = icmp eq i32 %tid, 0
  br label %header

header:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  br i1 %cond, label %then, label %else

then:
  store volatile i32 1, ptr addrspace(1) %out
  br label %latch

else:
  store volatile i32 2, ptr addrspace(1) %out
  %done = icmp eq i32 %i, %n
  br i1 %done, label %exit, label %latch

latch:
  %i.next = add i32 %i, 1
  br label %header

exit:
  ret void
}
