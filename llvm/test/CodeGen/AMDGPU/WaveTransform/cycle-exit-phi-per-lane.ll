  br i1 %div.cond, label %exit, label %header

exit:                                             ; preds = %header, %entry
  %acc = phi i32 [ 1, %header ], [ 0, %entry ]
  %guard = icmp eq i32 %acc, 0
  br i1 %guard, label %store.bb, label %ret.bb

store.bb:                                         ; preds = %exit
