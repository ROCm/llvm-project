; CHECK-SAME: <8 x bfloat> [[V:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[R:%.*]] = shufflevector <8 x bfloat> [[V]], <8 x bfloat> poison, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 8, i32 9, i32 10, i32 11>
; CHECK-NEXT:    ret <8 x bfloat> [[R]]
;
  %r = shufflevector <8 x bfloat> %v, <8 x bfloat> poison, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 8, i32 9, i32 10, i32 11>
  ret <8 x bfloat> %r
}

; Operand has a nonzero, non-poison lane, so it must NOT be canonicalized.
define <4 x float> @no_canon_nonzero_lane(<4 x float> %v) {
