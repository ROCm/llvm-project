; CHECK-SAME: <4 x float> [[V:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[R:%.*]] = shufflevector <4 x float> [[V]], <4 x float> <float poison, float poison, float 1.000000e+00, float 0.000000e+00>, <4 x i32> <i32 0, i32 1, i32 6, i32 7>
; CHECK-NEXT:    ret <4 x float> [[R]]
;
  %r = shufflevector <4 x float> %v, <4 x float> <float poison, float poison, float 1.0, float 0.0>, <4 x i32> <i32 0, i32 1, i32 6, i32 7>
