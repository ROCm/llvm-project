; A shufflevector constant operand made of only poison and zero lanes (a padded
; WMMA operand) is canonicalized to a full zeroinitializer, giving ISel a single
; uniform zero.

define <16 x bfloat> @canon_mixed_poison_zero(<16 x bfloat> %v) {
; CHECK-LABEL: define <16 x bfloat> @canon_mixed_poison_zero(
; CHECK-SAME: <16 x bfloat> [[V:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[R:%.*]] = shufflevector <16 x bfloat> [[V]], <16 x bfloat> zeroinitializer, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 24, i32 25, i32 26, i32 27, i32 28, i32 29, i32 30, i32 31>
; CHECK-NEXT:    ret <16 x bfloat> [[R]]
;
  %r = shufflevector <16 x bfloat> %v, <16 x bfloat> <bfloat poison, bfloat poison, bfloat poison, bfloat poison, bfloat poison, bfloat poison, bfloat poison, bfloat poison, bfloat 0.0, bfloat 0.0, bfloat 0.0, bfloat 0.0, bfloat 0.0, bfloat 0.0, bfloat 0.0, bfloat 0.0>, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 24, i32 25, i32 26, i32 27, i32 28, i32 29, i32 30, i32 31>
  ret <16 x bfloat> %r
}

; All-poison operand: no zero lane, so it must NOT be canonicalized.
define <8 x bfloat> @no_canon_all_poison(<8 x bfloat> %v) {
