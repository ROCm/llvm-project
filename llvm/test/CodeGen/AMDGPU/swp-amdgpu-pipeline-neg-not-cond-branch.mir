# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=pipeliner -debug-only=pipeliner %s -o /dev/null 2>&1 | FileCheck %s
# REQUIRES: asserts
# Reject a uniform loop with a fall-through exit latch.
# CHECK: Unable to analyzeLoop, can NOT pipeline Loop

--- |
  define amdgpu_kernel void @swp_amdgpu_pipeline_neg_not_cond_branch(i32 inreg %n, ptr addrspace(1) inreg %out) #0 {
  entry:
    br label %loop

  loop:                                             ; preds = %loop, %entry
    %i = phi i32 [ 0, %entry ], [ %inc, %loop ]
    %acc = phi i32 [ 0, %entry ], [ %add, %loop ]
    %add = add i32 %acc, %i
    %inc = add i32 %i, 1
    %cmp = icmp eq i32 %n, %inc
    br i1 %cmp, label %exit, label %loop

  exit:                                             ; preds = %loop
    %add.lcssa = phi i32 [ %add, %loop ]
    store i32 %add.lcssa, ptr addrspace(1) %out, align 4
    ret void
  }

  attributes #0 = { "target-cpu"="gfx950" }
...
---
name:            swp_amdgpu_pipeline_neg_not_cond_branch
alignment:       4
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: sreg_32 }
  - { id: 1, class: sreg_32 }
  - { id: 2, class: sreg_32 }
  - { id: 3, class: sreg_32 }
  - { id: 10, class: sreg_32 }
  - { id: 11, class: sreg_64_xexec_xnull }
  - { id: 17, class: sreg_32 }
  - { id: 19, class: vgpr_32 }
  - { id: 20, class: av_32 }
liveins:
  - { reg: '$sgpr8', virtual-reg: '%10' }
  - { reg: '$sgpr10_sgpr11', virtual-reg: '%11' }
machineFunctionInfo:
  isEntryFunction: true
  argumentInfo:
    kernargSegmentPtr: { reg: '$sgpr4_sgpr5' }
    firstKernArgPreloadReg: { reg: '$sgpr8' }
  stackPtrOffsetReg: '$sgpr32'
  occupancy:       8
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $sgpr8, $sgpr10_sgpr11

    %11:sreg_64_xexec_xnull = COPY $sgpr10_sgpr11
    %10:sreg_32 = COPY $sgpr8
    %17:sreg_32 = S_MOV_B32 0

  bb.1.loop:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)

    %0:sreg_32 = PHI %17, %bb.0, %3, %bb.1
    %1:sreg_32 = PHI %17, %bb.0, %2, %bb.1
    %2:sreg_32 = S_ADD_I32 %1, %0, implicit-def dead $scc
    %3:sreg_32 = S_ADD_I32 %0, 1, implicit-def dead $scc
    S_CMP_LG_U32 %10, %3, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc

  bb.2.exit:
    %19:vgpr_32 = AV_MOV_B32_IMM_PSEUDO 0, implicit $exec
    %20:av_32 = COPY %2
    GLOBAL_STORE_DWORD_SADDR killed %19, %20, %11, 0, 0, implicit $exec :: (store (s32) into %ir.out, addrspace 1)
    S_ENDPGM 0
...
