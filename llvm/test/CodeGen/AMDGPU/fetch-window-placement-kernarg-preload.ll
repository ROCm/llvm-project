  store i32 1, ptr addrspace(1) %g3
  %g4 = getelementptr i32, ptr addrspace(1) %p, i64 256
  store i32 1, ptr addrspace(1) %g4
  %g5 = getelementptr i32, ptr addrspace(1) %p, i64 320
  store i32 1, ptr addrspace(1) %g5
  %g6 = getelementptr i32, ptr addrspace(1) %p, i64 384
  store i32 1, ptr addrspace(1) %g6
  %g7 = getelementptr i32, ptr addrspace(1) %p, i64 448
  store i32 1, ptr addrspace(1) %g7
