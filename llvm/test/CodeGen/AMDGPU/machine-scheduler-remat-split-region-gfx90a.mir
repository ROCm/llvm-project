# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.0a -run-pass=machine-scheduler -verify-machineinstrs %s -o - | FileCheck %s

# With a unified VGPR file, the RP target uses the maximum ArchVGPR and AGPR
# counts, which are at different instructions here. %r is dead at the AGPR peak
# but live at the ArchVGPR peak, so rematerializing %r into bb.1 after the
# ArchVGPR peak reduces the pressure and allows occupancy 8.

--- |
  define amdgpu_kernel void @unified_banks() #0 { ret void }
  attributes #0 = { "amdgpu-waves-per-eu"="8,8" }
...
---
name:            unified_banks
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: unified_banks
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %q:sgpr_32 = S_MOV_B32 7
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:vreg_256 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF1:%[0-9]+]]:vreg_256 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF2:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF3:%[0-9]+]]:vreg_256 = IMPLICIT_DEF
  ; CHECK-NEXT:   INLINEASM &"; vgpr peak", sideeffect attdialect, implicit [[DEF]], implicit [[DEF1]], implicit [[DEF3]], implicit [[DEF2]], implicit-def $m0
  ; CHECK-NEXT:   [[DEF4:%[0-9]+]]:vreg_256 = IMPLICIT_DEF
  ; CHECK-NEXT:   S_NOP 0, implicit [[DEF4]], implicit $m0, implicit-def $m0
  ; CHECK-NEXT:   INLINEASM &"; define agprs", sideeffect attdialect, implicit $m0, implicit-def %6, implicit-def %7, implicit-def %8, implicit-def %9, implicit-def %10
  ; CHECK-NEXT:   INLINEASM &"; use agprs", sideeffect attdialect, implicit %6, implicit %7, implicit %8, implicit %9, implicit %10, implicit %q, implicit $m0, implicit-def $m0
  ; CHECK-NEXT:   S_NOP 0, implicit %q, implicit $m0
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    %r:vreg_256 = IMPLICIT_DEF
    %q:sgpr_32 = S_MOV_B32 7
    S_BRANCH %bb.1

  bb.1:
    %0:vreg_256 = IMPLICIT_DEF
    %1:vreg_256 = IMPLICIT_DEF
    %2:vreg_256 = IMPLICIT_DEF
    %3:vgpr_32 = IMPLICIT_DEF
    INLINEASM &"; vgpr peak", 1, implicit %0, implicit %1, implicit %2, implicit %3, implicit-def $m0
    S_NOP 0, implicit %r, implicit $m0, implicit-def $m0
    INLINEASM &"; define agprs", 1, implicit $m0, implicit-def %4:areg_256, implicit-def %5:areg_256, implicit-def %6:areg_256, implicit-def %7:areg_256, implicit-def %8:areg_64
    INLINEASM &"; use agprs", 1, implicit %4, implicit %5, implicit %6, implicit %7, implicit %8, implicit %q, implicit $m0, implicit-def $m0
    S_NOP 0, implicit %q, implicit $m0
    S_ENDPGM 0
...
