# RUN: llc -mtriple=amdgpu9.08 -run-pass=machine-scheduler -verify-machineinstrs %s -o - | FileCheck %s

# Each function is one scheduling region whose RP peak is an INLINEASM that uses
# 32 VGPRs. %r is rematerializable and also live at the peak.

--- |
  define amdgpu_kernel void @remat_across_peak() { ret void }
  define amdgpu_kernel void @no_remat_used_at_peak() #0 { ret void }
  attributes #0 = { "amdgpu-waves-per-eu"="8,8" }
...

# %r is used before and after the peak, not by the peak instruction. A copy of
# %r after the INLINEASM reduces the peak to 32 VGPRs, which allows occupancy 8.
