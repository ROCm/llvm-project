---
name:            partially_live_wide_subreg
tracksRegLiveness: true
body:             |
  bb.0.entry:
    ; GCN-LABEL: name: partially_live_wide_subreg
    ; GCN: [[DEF:%[0-9]+]]:sreg_64 = IMPLICIT_DEF
    ; GCN-NEXT: [[S_LOAD_DWORDX4_IMM:%[0-9]+]]:sgpr_128 = S_LOAD_DWORDX4_IMM [[DEF]], 1, 0
    ; GCN-NEXT: [[S_MOV_B64_:%[0-9]+]]:sreg_64 = S_MOV_B64 [[S_LOAD_DWORDX4_IMM]].sub2_sub3
    ; GCN-NEXT: [[S_MOV_B64_1:%[0-9]+]]:sreg_64 = S_MOV_B64 2, implicit $m0
    ; GCN-NEXT: [[S_MOV_B64_2:%[0-9]+]]:sreg_64 = S_MOV_B64 3, implicit $m0
    ; GCN-NEXT: dead renamable $vgpr0 = V_MOV_B32_e32 [[S_LOAD_DWORDX4_IMM]].sub0, implicit $exec, implicit [[S_MOV_B64_1]], implicit [[S_MOV_B64_2]]
    ; GCN-NEXT: dead renamable $vgpr0_vgpr1 = V_MOV_B64_PSEUDO [[S_MOV_B64_]], implicit $exec
    ; GCN-NEXT: S_NOP 0, implicit [[S_LOAD_DWORDX4_IMM]].sub0, implicit [[S_LOAD_DWORDX4_IMM]].sub3
    %0:sreg_64 = IMPLICIT_DEF
    %1:sgpr_128 = S_LOAD_DWORDX4_IMM %0, 1, 0
    %2:sreg_64 = S_MOV_B64 %1.sub2_sub3
    %3:sreg_64 = S_MOV_B64 2, implicit $m0
    %4:sreg_64 = S_MOV_B64 3, implicit $m0
    %5:vgpr_32 = V_MOV_B32_e32 %1.sub0, implicit $exec, implicit %3, implicit %4
    %6:vreg_64 = V_MOV_B64_PSEUDO %2, implicit $exec
    S_NOP 0, implicit %1.sub0, implicit %1.sub3
...
