# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=pipeliner -debug-only=pipeliner %s -o /dev/null 2>&1 | FileCheck %s
# REQUIRES: asserts
# Reject a loop whose body contains inline asm.
# analyzeLoopForPipelining returns nullptr.
# CHECK: Unable to analyzeLoop, can NOT pipeline Loop

--- |
  define amdgpu_kernel void @swp_amdgpu_pipeline_neg_inlineasm(i32 inreg %n) #0 {
  entry:
    br label %loop

  loop:                                             ; preds = %loop, %entry
    br label %loop
  }

  attributes #0 = { "target-cpu"="gfx950" }
...
---
name:            swp_amdgpu_pipeline_neg_inlineasm
alignment:       4
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: sreg_32 }
  - { id: 1, class: sreg_32 }
  - { id: 10, class: sreg_32 }
  - { id: 17, class: sreg_32 }
liveins:
  - { reg: '$sgpr8', virtual-reg: '%10' }
machineFunctionInfo:
  isEntryFunction: true
  argumentInfo:
    kernargSegmentPtr: { reg: '$sgpr4_sgpr5' }
    firstKernArgPreloadReg: { reg: '$sgpr8' }
  stackPtrOffsetReg: '$sgpr32'
  occupancy:       8
body:             |
  bb.0.entry:
    successors: %bb.1
    liveins: $sgpr8

    %10:sreg_32 = COPY $sgpr8
    %17:sreg_32 = S_MOV_B32 0

  bb.1.loop:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)

    %0:sreg_32 = PHI %17, %bb.0, %1, %bb.1
    INLINEASM &"s_nop 0", 1 /* sideeffect attdialect */
    %1:sreg_32 = S_ADD_I32 %0, 1, implicit-def dead $scc
    S_CMP_LG_U32 %10, %1, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...
