# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=postrapseudos -verify-machineinstrs -o - %s | FileCheck %s

---
# CHECK-LABEL: name: expand
# CHECK: $vgpr8_vgpr9_vgpr10_vgpr11 = DS_READ_B128_gfx9 $vgpr0, 16, 0, implicit $exec :: (invariant load (s128), addrspace 3)
# CHECK-NEXT: $vgpr12_vgpr13_vgpr14_vgpr15 = DS_READ_B128_gfx9 $vgpr0, 48, 0, implicit $exec, implicit-def $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15 :: (invariant load (s128), addrspace 3)
name: expand
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15 = DS_READ_B256_INVARIANT_PSEUDO $vgpr0, 16, 48, implicit $exec :: (invariant load (s128), addrspace 3), (invariant load (s128), addrspace 3)
    S_ENDPGM 0, implicit $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15
...
---
# The killed address was allocated inside the low half: load the high half
# first so the address is still intact for the second read.
# CHECK-LABEL: name: addr_in_low_half
# CHECK: $vgpr12_vgpr13_vgpr14_vgpr15 = DS_READ_B128_gfx9 $vgpr9, 48, 0, implicit $exec
# CHECK-NEXT: $vgpr8_vgpr9_vgpr10_vgpr11 = DS_READ_B128_gfx9 killed $vgpr9, 16, 0, implicit $exec, implicit-def $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15
name: addr_in_low_half
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr9
    $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15 = DS_READ_B256_INVARIANT_PSEUDO killed $vgpr9, 16, 48, implicit $exec :: (invariant load (s128), addrspace 3), (invariant load (s128), addrspace 3)
    S_ENDPGM 0, implicit $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15
...
---
# AGPR destination (MFMA operand kept in AGPRs).
# CHECK-LABEL: name: expand_agpr
# CHECK: $agpr0_agpr1_agpr2_agpr3 = DS_READ_B128_gfx9 $vgpr0, 0, 0, implicit $exec
# CHECK-NEXT: $agpr4_agpr5_agpr6_agpr7 = DS_READ_B128_gfx9 $vgpr0, 32, 0, implicit $exec, implicit-def $agpr0_agpr1_agpr2_agpr3_agpr4_agpr5_agpr6_agpr7
name: expand_agpr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    $agpr0_agpr1_agpr2_agpr3_agpr4_agpr5_agpr6_agpr7 = DS_READ_B256_INVARIANT_PSEUDO $vgpr0, 0, 32, implicit $exec :: (invariant load (s128), addrspace 3), (invariant load (s128), addrspace 3)
    S_ENDPGM 0, implicit $agpr0_agpr1_agpr2_agpr3_agpr4_agpr5_agpr6_agpr7
...
