# Scheduling ledger, backend half (AMDGPUSchedLedger.cpp): region entries that
# add ordering edges. The region below has three independent instructions
# (AND, OR, XOR); the ledger asks for the XOR before the AND.

# Without a ledger nothing changes.
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -o - %s | FileCheck %s --check-prefix=NONE

# Version 2 entry: region named by content signature, instructions by offset.
# Given by option and by environment variable.
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -amdgpu-sched-ledger=%S/Inputs/sched-ledger-order.json -o - %s | FileCheck %s --check-prefix=ORDER
# RUN: env PSCHED_LEDGER=%S/Inputs/sched-ledger-order.json llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -o - %s | FileCheck %s --check-prefix=ORDER
# RUN: env PSCHED_VERBOSE=1 llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -amdgpu-sched-ledger=%S/Inputs/sched-ledger-order.json -o /dev/null %s 2>&1 | FileCheck %s --check-prefix=VERBOSE

# Instruction ids shifted, as if code had been added earlier in the function:
# a version 2 entry still binds, a version 1 entry (absolute ids) is ignored
# and reported.
# RUN: env PSCHED_TEST_ID_SKEW=100 llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -amdgpu-sched-ledger=%S/Inputs/sched-ledger-order.json -o - %s | FileCheck %s --check-prefix=ORDER
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -amdgpu-sched-ledger=%S/Inputs/sched-ledger-v1.json -o - %s | FileCheck %s --check-prefix=ORDER
# RUN: env PSCHED_TEST_ID_SKEW=100 llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -amdgpu-sched-ledger=%S/Inputs/sched-ledger-v1.json -o - %s 2>/dev/null | FileCheck %s --check-prefix=NONE
# RUN: env PSCHED_TEST_ID_SKEW=100 llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -amdgpu-sched-ledger=%S/Inputs/sched-ledger-v1.json -o /dev/null %s 2>&1 | FileCheck %s --check-prefix=V1STALE

# A signature that is in no region: not applied, reported once with the closest
# region. With PSCHED_SALVAGE the entry is carried over and that is reported.
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -amdgpu-sched-ledger=%S/Inputs/sched-ledger-stale.json -o - %s 2>/dev/null | FileCheck %s --check-prefix=NONE
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -amdgpu-sched-ledger=%S/Inputs/sched-ledger-stale.json -o /dev/null %s 2>&1 | FileCheck %s --check-prefix=STALE
# RUN: env PSCHED_SALVAGE=1 llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -amdgpu-sched-ledger=%S/Inputs/sched-ledger-stale.json -o - %s 2>/dev/null | FileCheck %s --check-prefix=ORDER
# RUN: env PSCHED_SALVAGE=1 llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -amdgpu-sched-ledger=%S/Inputs/sched-ledger-stale.json -o /dev/null %s 2>&1 | FileCheck %s --check-prefix=SALVAGED

# An edge that contradicts a dependency (the OR of the AND's result before the
# AND) is skipped with a warning: a ledger cannot produce an illegal schedule.
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -amdgpu-sched-ledger=%S/Inputs/sched-ledger-cycle.json -o - %s 2>/dev/null | FileCheck %s --check-prefix=NONE
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -amdgpu-sched-ledger=%S/Inputs/sched-ledger-cycle.json -o /dev/null %s 2>&1 | FileCheck %s --check-prefix=CYCLE

# The DAG dump names the region the way a ledger does.
# RUN: rm -rf %t && llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=machine-scheduler -amdgpu-sched-ledger-dump=%t -o /dev/null %s
# RUN: FileCheck %s --check-prefix=DUMP --input-file=%t/test.jsonl

# NONE:      V_AND_B32_e32
# NONE-NEXT: V_OR_B32_e32
# NONE-NEXT: V_XOR_B32_e32

# ORDER:     V_XOR_B32_e32
# ORDER:     V_AND_B32_e32

# VERBOSE: psched: test <- region 45dd1065 (8 instructions): 0 latency override(s), 1 order edge(s)

# V1STALE: psched: warning: region 6cf8af1b ({{.*}}sched-ledger-v1.json) matched nothing in test (stale ledger?)

# STALE: psched: warning: region deadbeef ({{.*}}sched-ledger-stale.json) matched no code in this compilation (stale ledger?); the closest region aligned 100%, in test

# SALVAGED: psched: warning: region deadbeef ({{.*}}sched-ledger-stale.json) has changed in test: 100% of its instructions align with region 45dd1065; salvaged 1 of 1 order edge(s)

# CYCLE: psched: warning: order 5 -> 2 ({{.*}}sched-ledger-cycle.json) contradicts a dependency in test; edge skipped

# DUMP: "fn":"test"
# DUMP-SAME: "n":8
# DUMP-SAME: "off":4
# DUMP-SAME: "sig":"45dd1065"

--- |
  define amdgpu_kernel void @test() { ret void }
...
---
name: test
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = V_AND_B32_e32 %0, %1, implicit $exec
    %3:vgpr_32 = V_OR_B32_e32 %0, %1, implicit $exec
    %4:vgpr_32 = V_XOR_B32_e32 %0, %1, implicit $exec
    %5:vgpr_32 = V_OR_B32_e32 %2, %3, implicit $exec
    %6:vgpr_32 = V_OR_B32_e32 %5, %4, implicit $exec
    $vgpr0 = COPY %6
    S_ENDPGM 0, implicit $vgpr0
...
