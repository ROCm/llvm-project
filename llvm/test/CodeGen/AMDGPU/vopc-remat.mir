# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -amdgpu-late-wave-transform=1 -mtriple=amdgpu9.42-amd-amdhsa --stress-regalloc=2 -start-before=greedy -stop-after=virtregrewriter -o - %s | FileCheck -check-prefix=GCN %s

# Test that V_CMP_*_e64 instructions are rematerialized instead of spilled.

---
name:            test_vopc_e64_remat
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
  stackPtrOffsetReg: $sgpr32
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; GCN-LABEL: name: test_vopc_e64_remat
    ; GCN: liveins: $vgpr0, $vgpr1
    ; GCN-NEXT: {{  $}}
    ; GCN-NEXT: [[V_CMP_GT_U32_e64_:%[0-9]+]]:sreg_64 = V_CMP_GT_U32_e64 $vgpr0, $vgpr1, implicit $exec
    ; GCN-NEXT: [[V_CMP_LT_U32_e64_:%[0-9]+]]:sreg_64 = V_CMP_LT_U32_e64 $vgpr0, $vgpr1, implicit $exec
    ; GCN-NEXT: [[V_CMP_EQ_U32_e64_:%[0-9]+]]:sreg_64 = V_CMP_EQ_U32_e64 $vgpr0, $vgpr1, implicit $exec
    ; GCN-NEXT: INLINEASM &"", sideeffect attdialect
    ; GCN-NEXT: [[S_AND_B64_:%[0-9]+]]:sreg_64 = S_AND_B64 [[V_CMP_GT_U32_e64_]], $exec, implicit-def $scc
    ; GCN-NEXT: S_NOP 0, implicit [[S_AND_B64_]]
    ; GCN-NEXT: [[S_AND_B64_1:%[0-9]+]]:sreg_64 = S_AND_B64 [[V_CMP_LT_U32_e64_]], $exec, implicit-def $scc
    ; GCN-NEXT: S_NOP 0, implicit [[S_AND_B64_1]]
    ; GCN-NEXT: [[S_AND_B64_2:%[0-9]+]]:sreg_64 = S_AND_B64 [[V_CMP_EQ_U32_e64_]], $exec, implicit-def $scc
    ; GCN-NEXT: S_NOP 0, implicit [[S_AND_B64_2]], implicit killed renamable $vgpr0, implicit killed renamable $vgpr1
    ; GCN-NEXT: S_ENDPGM 0
    %10:vgpr_32 = COPY $vgpr0
    %11:vgpr_32 = COPY $vgpr1
    %0:sreg_64 = V_CMP_GT_U32_e64 %10, %11, implicit $exec
    %1:sreg_64 = V_CMP_LT_U32_e64 %10, %11, implicit $exec
    %2:sreg_64 = V_CMP_EQ_U32_e64 %10, %11, implicit $exec
    INLINEASM &"", sideeffect attdialect
    %3:sreg_64 = S_AND_B64 %0, $exec, implicit-def $scc
    S_NOP 0, implicit %3
    %4:sreg_64 = S_AND_B64 %1, $exec, implicit-def $scc
    S_NOP 0, implicit %4
    %5:sreg_64 = S_AND_B64 %2, $exec, implicit-def $scc
    S_NOP 0, implicit %5, implicit %10, implicit %11
    S_ENDPGM 0
...
