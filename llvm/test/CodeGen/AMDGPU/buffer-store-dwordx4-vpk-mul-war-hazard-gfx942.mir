# RUN: llc -mtriple=amdgcn -mcpu=gfx950 -verify-machineinstrs \
# RUN:   -run-pass=post-RA-hazard-rec %s -o - | FileCheck -check-prefix=GFX950 %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx942 -verify-machineinstrs \
# RUN:   -run-pass=post-RA-hazard-rec %s -o - | FileCheck -check-prefix=GFX942 %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -verify-machineinstrs \
# RUN:   -run-pass=post-RA-hazard-rec %s -o - | FileCheck -check-prefix=GFX900 %s

# Tests for the BUFFER_STORE source-vgpr WAR hazard on gfx940-family
# subtargets (gfx942, gfx950).
#
# A buffer_store_dwordx4 (or any MUBUF store wider than 8 bytes) immediately
# followed by a VALU instruction that overwrites two of the source vgprs
# (typically v_pk_mul_f32 / v_pk_add_f32 writing v[X:X+1]) loses the bytes
# of one dword to the post-write value on gfx940 family. The hazard
# recognizer must insert one wait state (S_NOP 1) between them.
#
# Pre-gfx940 the hazard existed only with literal/absent SOFFSET; the
# pre-existing rule keeps its narrow gating for those targets.

# A dwordx4 store with SGPR-sourced SOFFSET, immediately followed by a
# v_pk_mul_f32 writing the source v[0:1]. On gfx942/gfx950 a 1-wait-state
# nop must be inserted. On gfx900 (older) no nop is needed because the
# pre-gfx940 gate excludes SGPR-sourced soffset.
# GFX950-LABEL: name: buffer_store_dwordx4_sgpr_soffset_then_vpk_mul
# GFX950: BUFFER_STORE_DWORDX4_OFFEN_exact
# GFX950-NEXT: S_NOP 1
# GFX950-NEXT: $vgpr0_vgpr1 = nofpexcept V_PK_MUL_F32
#
# GFX942-LABEL: name: buffer_store_dwordx4_sgpr_soffset_then_vpk_mul
# GFX942: BUFFER_STORE_DWORDX4_OFFEN_exact
# GFX942-NEXT: S_NOP 1
# GFX942-NEXT: $vgpr0_vgpr1 = nofpexcept V_PK_MUL_F32
#
# GFX900-LABEL: name: buffer_store_dwordx4_sgpr_soffset_then_vpk_mul
# GFX900: BUFFER_STORE_DWORDX4_OFFEN_exact
# GFX900-NEXT: $vgpr0_vgpr1 = nofpexcept V_PK_MUL_F32

---
name: buffer_store_dwordx4_sgpr_soffset_then_vpk_mul
body: |
  bb.0:
    BUFFER_STORE_DWORDX4_OFFEN_exact $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4, $sgpr8_sgpr9_sgpr10_sgpr11, $sgpr1, 0, 0, 0, implicit $exec
    $vgpr0_vgpr1 = nofpexcept V_PK_MUL_F32 0, $sgpr0_sgpr1, 8, $vgpr8_vgpr9, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...

# Same store but with a literal-zero SOFFSET. The pre-existing rule
# already covers this on every target. This test guards against
# accidentally regressing the literal-soffset path.
# GFX950-LABEL: name: buffer_store_dwordx4_literal_soffset_then_vpk_mul
# GFX950: BUFFER_STORE_DWORDX4_OFFEN_exact
# GFX950-NEXT: S_NOP 1
# GFX950-NEXT: $vgpr0_vgpr1 = nofpexcept V_PK_MUL_F32
#
# GFX942-LABEL: name: buffer_store_dwordx4_literal_soffset_then_vpk_mul
# GFX942: BUFFER_STORE_DWORDX4_OFFEN_exact
# GFX942-NEXT: S_NOP 1
# GFX942-NEXT: $vgpr0_vgpr1 = nofpexcept V_PK_MUL_F32
#
# GFX900-LABEL: name: buffer_store_dwordx4_literal_soffset_then_vpk_mul
# GFX900: BUFFER_STORE_DWORDX4_OFFEN_exact
# GFX900-NEXT: S_NOP 0
# GFX900-NEXT: $vgpr0_vgpr1 = nofpexcept V_PK_MUL_F32

---
name: buffer_store_dwordx4_literal_soffset_then_vpk_mul
body: |
  bb.0:
    BUFFER_STORE_DWORDX4_OFFEN_exact $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4, $sgpr8_sgpr9_sgpr10_sgpr11, 0, 0, 0, 0, implicit $exec
    $vgpr0_vgpr1 = nofpexcept V_PK_MUL_F32 0, $sgpr0_sgpr1, 8, $vgpr8_vgpr9, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...

# A 64-bit store (dwordx2) does not trigger the hazard on any target -
# the rule only fires for stores wider than 64 bits.
# GFX950-LABEL: name: buffer_store_dwordx2_sgpr_soffset_then_vpk_mul_no_hazard
# GFX950: BUFFER_STORE_DWORDX2_OFFEN_exact
# GFX950-NEXT: $vgpr0_vgpr1 = nofpexcept V_PK_MUL_F32
#
# GFX942-LABEL: name: buffer_store_dwordx2_sgpr_soffset_then_vpk_mul_no_hazard
# GFX942: BUFFER_STORE_DWORDX2_OFFEN_exact
# GFX942-NEXT: $vgpr0_vgpr1 = nofpexcept V_PK_MUL_F32
#
# GFX900-LABEL: name: buffer_store_dwordx2_sgpr_soffset_then_vpk_mul_no_hazard
# GFX900: BUFFER_STORE_DWORDX2_OFFEN_exact
# GFX900-NEXT: $vgpr0_vgpr1 = nofpexcept V_PK_MUL_F32

---
name: buffer_store_dwordx2_sgpr_soffset_then_vpk_mul_no_hazard
body: |
  bb.0:
    BUFFER_STORE_DWORDX2_OFFEN_exact $vgpr0_vgpr1, $vgpr4, $sgpr8_sgpr9_sgpr10_sgpr11, $sgpr1, 0, 0, 0, implicit $exec
    $vgpr0_vgpr1 = nofpexcept V_PK_MUL_F32 0, $sgpr0_sgpr1, 8, $vgpr8_vgpr9, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...

# A dwordx4 store followed by a write to a NON-overlapping vgpr range.
# No hazard, no nop, on any target.
# GFX950-LABEL: name: buffer_store_dwordx4_sgpr_soffset_then_unrelated_write
# GFX950: BUFFER_STORE_DWORDX4_OFFEN_exact
# GFX950-NEXT: $vgpr10_vgpr11 = nofpexcept V_PK_MUL_F32

---
name: buffer_store_dwordx4_sgpr_soffset_then_unrelated_write
body: |
  bb.0:
    BUFFER_STORE_DWORDX4_OFFEN_exact $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4, $sgpr8_sgpr9_sgpr10_sgpr11, $sgpr1, 0, 0, 0, implicit $exec
    $vgpr10_vgpr11 = nofpexcept V_PK_MUL_F32 0, $sgpr0_sgpr1, 8, $vgpr8_vgpr9, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
