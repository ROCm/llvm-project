entry:
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  %lds.gep = getelementptr [256 x i16], ptr addrspace(3) @lds, i32 0, i32 %tid
  store i16 7, ptr addrspace(3) %lds.gep, align 2
  fence syncscope("workgroup") release
  tail call void @llvm.amdgcn.s.barrier()
  fence syncscope("workgroup") acquire
  %tid.nz = icmp ne i32 %tid, 0
  %prev.idx = add i32 %tid, -1
  %prev.gep = getelementptr [256 x i16], ptr addrspace(3) @lds, i32 0, i32 %prev.idx
  br i1 %uni, label %armA, label %armB

; arm A: inner divergent LDS read, then a divergent guard whose "then" block is
; the shared %sink.
armA:
  br i1 %tid.nz, label %ldsA, label %joinA

ldsA:
  %pA = load i16, ptr addrspace(3) %prev.gep, align 2
  br label %joinA

joinA:
  %predA = phi i16 [ 11, %armA ], [ %pA, %ldsA ]
  %guard = icmp ult i32 %tid, %guard_limit
  br i1 %guard, label %sink, label %exit

; arm B: inner divergent LDS read whose join is the shared %sink.
armB:
  br i1 %tid.nz, label %bodyB, label %sink

bodyB:
  %pB = load i16, ptr addrspace(3) %prev.gep, align 2
  br label %sink

sink:
  %pred = phi i16 [ %predA, %joinA ], [ %pB, %bodyB ], [ 22, %armB ]
  %ne = icmp ne i16 %pred, 7
  %v = zext i1 %ne to i32
  br label %exit

exit:
  %flag = phi i32 [ 0, %joinA ], [ %v, %sink ]
  %out.gep = getelementptr i32, ptr addrspace(1) %out, i32 %tid
  store i32 %flag, ptr addrspace(1) %out.gep, align 4
  ret void
}

