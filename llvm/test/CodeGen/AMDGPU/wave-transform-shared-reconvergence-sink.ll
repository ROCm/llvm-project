; LWT-W32-NEXT:    global_store_b32 v0, v2, s[0:1]
; LWT-W32-NEXT:    s_endpgm
entry:
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  %prev.idx = add i32 %tid, -1
  %prev.gep = getelementptr [256 x i16], ptr addrspace(3) @lds, i32 0, i32 %prev.idx
  %tid.nz = icmp ne i32 %tid, 0
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %latch ]
  br i1 %uni, label %armA, label %armB

armA:
  br i1 %tid.nz, label %ldsA, label %joinA

ldsA:
  %pA = load i16, ptr addrspace(3) %prev.gep, align 2
  br label %joinA

joinA:
  %predA = phi i16 [ 11, %armA ], [ %pA, %ldsA ]
  %guard = icmp ult i32 %tid, %guard_limit
  br i1 %guard, label %sink, label %latch

armB:
  br i1 %tid.nz, label %bodyB, label %sink

bodyB:
  %pB = load i16, ptr addrspace(3) %prev.gep, align 2
  br label %sink

sink:
  %pred = phi i16 [ %predA, %joinA ], [ %pB, %bodyB ], [ 22, %armB ]
  %ne = icmp ne i16 %pred, 7
  %v = zext i1 %ne to i32
  br label %latch

latch:
  %contrib = phi i32 [ 0, %joinA ], [ %v, %sink ]
  %acc.next = add i32 %acc, %contrib
  %i.next = add i32 %i, 1
  %done = icmp slt i32 %i.next, %n
  br i1 %done, label %loop, label %end

end:
  %out.gep = getelementptr i32, ptr addrspace(1) %out, i32 %tid
  store i32 %acc.next, ptr addrspace(1) %out.gep, align 4
  ret void
}

