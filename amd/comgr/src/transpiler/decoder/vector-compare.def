//===----------------------------------------------------------------------===//
//
// Supported VOPC/VOP3 predicates, operand widths in bits, and whether to
// sign-extend 32-bit literals.
// VECTOR_COMPARE16 includes true16 and fake16 encodings.
//
//===----------------------------------------------------------------------===//

#ifndef VECTOR_COMPARE16
#define VECTOR_COMPARE16(Name, Predicate) \
  VECTOR_COMPARE(Name, Predicate, 16, false)
#endif

VECTOR_COMPARE(EQ_F32, FCMP_OEQ, 32, false)
VECTOR_COMPARE(EQ_F64, FCMP_OEQ, 64, false)
VECTOR_COMPARE16(EQ_I16, ICMP_EQ)
VECTOR_COMPARE(EQ_I32, ICMP_EQ, 32, false)
VECTOR_COMPARE(EQ_I64, ICMP_EQ, 64, true)
VECTOR_COMPARE16(EQ_U16, ICMP_EQ)
VECTOR_COMPARE(EQ_U32, ICMP_EQ, 32, false)
VECTOR_COMPARE(EQ_U64, ICMP_EQ, 64, false)
VECTOR_COMPARE(GE_F32, FCMP_OGE, 32, false)
VECTOR_COMPARE(GE_F64, FCMP_OGE, 64, false)
VECTOR_COMPARE16(GE_I16, ICMP_SGE)
VECTOR_COMPARE(GE_I32, ICMP_SGE, 32, false)
VECTOR_COMPARE(GE_I64, ICMP_SGE, 64, true)
VECTOR_COMPARE16(GE_U16, ICMP_UGE)
VECTOR_COMPARE(GE_U32, ICMP_UGE, 32, false)
VECTOR_COMPARE(GE_U64, ICMP_UGE, 64, false)
VECTOR_COMPARE(GT_F32, FCMP_OGT, 32, false)
VECTOR_COMPARE(GT_F64, FCMP_OGT, 64, false)
VECTOR_COMPARE16(GT_I16, ICMP_SGT)
VECTOR_COMPARE(GT_I32, ICMP_SGT, 32, false)
VECTOR_COMPARE(GT_I64, ICMP_SGT, 64, true)
VECTOR_COMPARE16(GT_U16, ICMP_UGT)
VECTOR_COMPARE(GT_U32, ICMP_UGT, 32, false)
VECTOR_COMPARE(GT_U64, ICMP_UGT, 64, false)
VECTOR_COMPARE(LE_F32, FCMP_OLE, 32, false)
VECTOR_COMPARE(LE_F64, FCMP_OLE, 64, false)
VECTOR_COMPARE16(LE_I16, ICMP_SLE)
VECTOR_COMPARE(LE_I32, ICMP_SLE, 32, false)
VECTOR_COMPARE(LE_I64, ICMP_SLE, 64, true)
VECTOR_COMPARE16(LE_U16, ICMP_ULE)
VECTOR_COMPARE(LE_U32, ICMP_ULE, 32, false)
VECTOR_COMPARE(LE_U64, ICMP_ULE, 64, false)
VECTOR_COMPARE(LG_F32, FCMP_ONE, 32, false)
VECTOR_COMPARE(LG_F64, FCMP_ONE, 64, false)
VECTOR_COMPARE(LT_F32, FCMP_OLT, 32, false)
VECTOR_COMPARE(LT_F64, FCMP_OLT, 64, false)
VECTOR_COMPARE16(LT_I16, ICMP_SLT)
VECTOR_COMPARE(LT_I32, ICMP_SLT, 32, false)
VECTOR_COMPARE(LT_I64, ICMP_SLT, 64, true)
VECTOR_COMPARE16(LT_U16, ICMP_ULT)
VECTOR_COMPARE(LT_U32, ICMP_ULT, 32, false)
VECTOR_COMPARE(LT_U64, ICMP_ULT, 64, false)
VECTOR_COMPARE(NEQ_F32, FCMP_UNE, 32, false)
VECTOR_COMPARE(NEQ_F64, FCMP_UNE, 64, false)
VECTOR_COMPARE16(NE_I16, ICMP_NE)
VECTOR_COMPARE(NE_I32, ICMP_NE, 32, false)
VECTOR_COMPARE(NE_I64, ICMP_NE, 64, true)
VECTOR_COMPARE16(NE_U16, ICMP_NE)
VECTOR_COMPARE(NE_U32, ICMP_NE, 32, false)
VECTOR_COMPARE(NE_U64, ICMP_NE, 64, false)
VECTOR_COMPARE(NGE_F32, FCMP_ULT, 32, false)
VECTOR_COMPARE(NGE_F64, FCMP_ULT, 64, false)
VECTOR_COMPARE(NGT_F32, FCMP_ULE, 32, false)
VECTOR_COMPARE(NGT_F64, FCMP_ULE, 64, false)
VECTOR_COMPARE(NLE_F32, FCMP_UGT, 32, false)
VECTOR_COMPARE(NLE_F64, FCMP_UGT, 64, false)
VECTOR_COMPARE(NLG_F32, FCMP_UEQ, 32, false)
VECTOR_COMPARE(NLG_F64, FCMP_UEQ, 64, false)
VECTOR_COMPARE(NLT_F32, FCMP_UGE, 32, false)
VECTOR_COMPARE(NLT_F64, FCMP_UGE, 64, false)
VECTOR_COMPARE(O_F32, FCMP_ORD, 32, false)
VECTOR_COMPARE(O_F64, FCMP_ORD, 64, false)
VECTOR_COMPARE(U_F32, FCMP_UNO, 32, false)
VECTOR_COMPARE(U_F64, FCMP_UNO, 64, false)

VECTOR_CLASS(F32, 32)
VECTOR_CLASS(F64, 64)

#undef VECTOR_CLASS
#undef VECTOR_COMPARE16
#undef VECTOR_COMPARE
