CANONICAL_OP(V_MAX_I32)
CANONICAL_OP(V_MIN_U32)
CANONICAL_OP(V_MAX_U32)
CANONICAL_OP(V_AND_B32)
CANONICAL_OP(V_OR_B32)
CANONICAL_OP(V_XOR_B32)
CANONICAL_OP(V_XNOR_B32)
CANONICAL_OP(V_LSHLREV_B32)
CANONICAL_OP(V_LSHRREV_B32)
CANONICAL_OP(V_ASHRREV_I32)
CANONICAL_OP(V_ADD_NC_U64)
CANONICAL_OP(V_SUB_NC_U64)
