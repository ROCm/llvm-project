#ifndef CANONICAL_OP
#error "define CANONICAL_OP(Name) before including canonical-op.def"
#endif

CANONICAL_OP(Unknown)

// SOP1.
CANONICAL_OP(S_MOV_B32)

// SOP2 integer arithmetic and selection.
CANONICAL_OP(S_ADD_U32)
CANONICAL_OP(S_ADD_I32)
CANONICAL_OP(S_ADDC_U32)
CANONICAL_OP(S_SUB_U32)
CANONICAL_OP(S_SUB_I32)
CANONICAL_OP(S_SUBB_U32)
CANONICAL_OP(S_ABSDIFF_I32)
CANONICAL_OP(S_MUL_I32)
CANONICAL_OP(S_MUL_HI_U32)
CANONICAL_OP(S_MUL_HI_I32)
CANONICAL_OP(S_MUL_U64)
CANONICAL_OP(S_CSELECT_B32)
CANONICAL_OP(S_CSELECT_B64)
CANONICAL_OP(S_MIN_I32)
CANONICAL_OP(S_MIN_U32)
CANONICAL_OP(S_MAX_I32)
CANONICAL_OP(S_MAX_U32)
CANONICAL_OP(S_LSHL1_ADD_U32)
CANONICAL_OP(S_LSHL2_ADD_U32)
CANONICAL_OP(S_LSHL3_ADD_U32)
CANONICAL_OP(S_LSHL4_ADD_U32)
CANONICAL_OP(S_ADD_NC_U64)
CANONICAL_OP(S_SUB_NC_U64)

// SOPP.
CANONICAL_OP(S_ENDPGM)

// SMEM.
CANONICAL_OP(S_LOAD_B32)
CANONICAL_OP(S_LOAD_B64)
CANONICAL_OP(S_LOAD_B128)

// VOP2 floating point.
CANONICAL_OP(V_ADD_F32)
CANONICAL_OP(V_MUL_F32)
CANONICAL_OP(V_SUB_F32)
CANONICAL_OP(V_SUBREV_F32)

// VOP2 integer arithmetic, bitwise and shift.
CANONICAL_OP(V_ADD_NC_U32)
CANONICAL_OP(V_SUB_NC_U32)
CANONICAL_OP(V_SUBREV_NC_U32)
CANONICAL_OP(V_ADD_CO_U32)
CANONICAL_OP(V_SUB_CO_U32)
CANONICAL_OP(V_SUBREV_CO_U32)
CANONICAL_OP(V_ADD_CO_CI_U32)
CANONICAL_OP(V_SUB_CO_CI_U32)
CANONICAL_OP(V_SUBREV_CO_CI_U32)
