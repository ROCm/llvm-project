#ifndef CANONICAL_OP
#error "define CANONICAL_OP(Name) before including canonical-op.def"
#endif

CANONICAL_OP(Unknown)

// -- SOP1 --
CANONICAL_OP(S_MOV_B32)

// -- SOPP / control flow --
CANONICAL_OP(S_ENDPGM)
CANONICAL_OP(S_WAITCNT)
CANONICAL_OP(S_WAIT_LOADCNT)
CANONICAL_OP(S_WAIT_STORECNT)
CANONICAL_OP(S_WAIT_DSCNT)
CANONICAL_OP(S_WAIT_KMCNT)
CANONICAL_OP(S_WAIT_EXPCNT)
CANONICAL_OP(S_WAIT_LOADCNT_DSCNT)
CANONICAL_OP(S_WAIT_STORECNT_DSCNT)
CANONICAL_OP(S_WAIT_IDLE)
CANONICAL_OP(S_WAIT_ASYNCCNT)
CANONICAL_OP(S_WAIT_TENSORCNT)
CANONICAL_OP(S_WAIT_XCNT)
CANONICAL_OP(S_WAIT_ALU)
CANONICAL_OP(S_NOP)
CANONICAL_OP(S_CLAUSE)
CANONICAL_OP(S_DELAY_ALU)
CANONICAL_OP(S_SLEEP)
CANONICAL_OP(S_SETPRIO)
