#ifndef CANONICAL_OP
#error "define CANONICAL_OP(Name) before including canonical-op.def"
#endif

CANONICAL_OP(Unknown)
CANONICAL_OP(S_MOV_B32)
CANONICAL_OP(S_ENDPGM)
CANONICAL_OP(S_MOV_B64)
CANONICAL_OP(S_CMOV_B32)
CANONICAL_OP(S_CMOV_B64)
CANONICAL_OP(S_BREV_B32)
CANONICAL_OP(S_BREV_B64)
CANONICAL_OP(S_NOT_B32)
CANONICAL_OP(S_NOT_B64)
