#ifndef CANONICAL_OP
#error "define CANONICAL_OP(Name) before including canonical-op.def"
#endif

CANONICAL_OP(Unknown)

// SOP1.
CANONICAL_OP(S_MOV)

// SOP2 integer arithmetic.
CANONICAL_OP(S_ABSDIFF)
CANONICAL_OP(S_ADDC)
CANONICAL_OP(S_ADD)
